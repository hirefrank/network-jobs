#!/usr/bin/env bash
# network-jobs — local CLI for setup, doctor, and LinkedIn import.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=lib/agents.sh
source "$ROOT/lib/agents.sh"

DATA_HOME="${NETWORK_JOBS_HOME:-$HOME/.network-jobs}"
export NETWORK_JOBS_SUITE="${NETWORK_JOBS_SUITE:-$ROOT}"

cmd="${1:-}"
shift || true

usage() {
  cat <<'EOF'
Usage: network-jobs [--help] <command> [options]

Commands:
  setup [--agent auto|all|name,...] [--force] [--copy] [--with-browser] [-v]
      Create ~/.network-jobs and install skills into agent skill dirs

  doctor
      Check tools, data dir, profile, skill links, corpus

  import <zip-or-csv> [--min-count N]
      Parse LinkedIn Connections into the local company graph

  reset [--agent auto|all|name,...] [--data] [--purge-cache] [--yes]
      Remove installed skill links (keeps ~/.network-jobs unless --data)

  uninstall [--agent auto|all|name,...] [--purge-cache] [--yes]
      Full wipe: skills + ~/.network-jobs (same as reset --data)

  agents
      List supported agents and detection status

  routing
      Print the optional AGENTS.md / CLAUDE.md routing snippet

  which
      Print suite root and data home

  help [command]
      Show this help, or detailed help for one command

Global:
  -h, --help     Show this help
  -V, --version  Print package version

Env:
  NETWORK_JOBS_HOME        Data directory (default: ~/.network-jobs)
  NETWORK_JOBS_SKILLS_DIR  Install skills into this single parent only

Day-to-day use happens in your agent. The CLI is for install, doctor, and import.
EOF
}

usage_setup() {
  cat <<'EOF'
Usage: network-jobs setup [options]

Create ~/.network-jobs and link skills into one or more agent skill directories.

Options:
  --agent <list>    Target agents: auto (default), all, or claude-code,cursor,…
  --force           Replace existing non-symlink skill dirs (e.g. older installs)
  --copy            Copy skills instead of symlinking
  --with-browser    Also install the optional agent-browser CLI globally
  --print-routing   Print the AGENTS.md routing snippet when finished
  --verbose, -v     Show every path as it is linked
  --help, -h        Show this help

Env:
  NETWORK_JOBS_HOME        Data directory (default: ~/.network-jobs)
  NETWORK_JOBS_SKILLS_DIR  Single skills parent (overrides --agent)
EOF
}

usage_doctor() {
  cat <<'EOF'
Usage: network-jobs doctor

Check required tools, the data directory, profile completeness, skill links,
and corpus status. Exit 0 when healthy, 1 when issues are found.

Options:
  --help, -h   Show this help
EOF
}

usage_import() {
  cat <<'EOF'
Usage: network-jobs import <zip-or-csv> [--min-count N]

Parse a LinkedIn Connections export (ZIP or Connections.csv) into:
  ~/.network-jobs/connections/connections.json
  ~/.network-jobs/companies/companies.json

Options:
  --min-count N   Only keep companies with at least N connections (default: 1)
  --help, -h      Show this help

Examples:
  network-jobs import ~/Downloads/Connections.zip
  network-jobs import ./fixtures/Connections.csv --min-count 2
EOF
}

usage_reset() {
  cat <<'EOF'
Usage: network-jobs reset [options]
       network-jobs uninstall [options]

Remove installed skill links from agent skill directories.

Options:
  --agent <list>   Target agents: auto (default), all, or claude-code,cursor,…
  --data           Also delete ~/.network-jobs (connections, corpus, profile)
  --purge-cache    Also clear cached npx/pnpm copies of this suite
  --yes, -y        Skip confirmation
  --help, -h       Show this help

uninstall is an alias for reset --data.

Examples:
  network-jobs reset --yes
  network-jobs uninstall --yes --purge-cache
  npx github:hirefrank/network-jobs setup --agent auto
EOF
}

usage_agents() {
  cat <<'EOF'
Usage: network-jobs agents

List supported agents, their skill directories, and whether each was detected
on this machine (tab-separated: name, path, status).

Options:
  --help, -h   Show this help
EOF
}

usage_routing() {
  cat <<'EOF'
Usage: network-jobs routing

Print the optional AGENTS.md / CLAUDE.md routing snippet. Skills already
self-describe via frontmatter; this is only if you want the workflow pinned
in a project's instructions.

Options:
  --help, -h   Show this help
EOF
}

usage_which() {
  cat <<'EOF'
Usage: network-jobs which

Print the suite root and data home paths.

Options:
  --help, -h   Show this help
EOF
}

cmd_help() {
  local topic="${1:-}"
  case "$topic" in
    "" ) usage ;;
    setup) usage_setup ;;
    doctor) usage_doctor ;;
    import) usage_import ;;
    reset|uninstall) usage_reset ;;
    agents) usage_agents ;;
    routing) usage_routing ;;
    which) usage_which ;;
    help)
      cat <<'EOF'
Usage: network-jobs help [command]

Show top-level help, or detailed help for one command.
EOF
      ;;
    *)
      echo "Unknown command: $topic" >&2
      echo "Try: network-jobs --help" >&2
      return 1
      ;;
  esac
}

network_jobs_want_help() {
  local arg
  for arg in "$@"; do
    case "$arg" in
      -h|--help|help) return 0 ;;
    esac
  done
  return 1
}

network_jobs_version() {
  local pkg="$ROOT/package.json"
  if [[ -f "$pkg" ]] && command -v jq >/dev/null 2>&1; then
    jq -r '"network-jobs " + (.version // "0.0.0")' "$pkg"
  else
    echo "network-jobs"
  fi
}

network_jobs_resolve_agents() {
  local csv="${1:-auto}"
  local -a names=()
  local name
  case "$csv" in
    all) names=("${NETWORK_JOBS_AGENT_IDS[@]}") ;;
    auto)
      while IFS= read -r name; do
        [[ -n "$name" ]] && names+=("$name")
      done < <(network_jobs_detect_agents)
      ;;
    *)
      IFS=',' read -ra names <<<"$csv"
      ;;
  esac
  for name in "${names[@]}"; do
    name="$(echo "$name" | xargs)"
    [[ -n "$name" ]] && printf '%s\n' "$name"
  done
}

cmd_reset() {
  local agents_csv="auto"
  local wipe_data=0
  local yes=0
  local purge_cache=0

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --agent|--agents) agents_csv="$2"; shift 2 ;;
      --data|--wipe-data) wipe_data=1; shift ;;
      --purge-cache) purge_cache=1; shift ;;
      -y|--yes) yes=1; shift ;;
      -h|--help) usage_reset; return 0 ;;
      *)
        echo "Unknown arg: $1" >&2
        echo "Try: network-jobs reset --help" >&2
        return 1
        ;;
    esac
  done

  local -a agent_names=()
  local name dir skill dest
  while IFS= read -r name; do
    [[ -n "$name" ]] && agent_names+=("$name")
  done < <(network_jobs_resolve_agents "$agents_csv")

  if ((${#agent_names[@]} == 0)); then
    echo "error: no agents selected" >&2
    return 1
  fi

  echo "This will remove:"
  for name in "${agent_names[@]}"; do
    dir="$(network_jobs_agent_dir "$name" || true)"
    [[ -z "$dir" ]] && continue
    echo "  skills in $dir ($name)"
  done
  if [[ "$wipe_data" -eq 1 ]]; then
    echo "  data dir $DATA_HOME"
  else
    echo "  (keeping data dir $DATA_HOME — pass --data to wipe)"
  fi
  if [[ "$purge_cache" -eq 1 ]]; then
    echo "  cached npx/pnpm copies of @hirefrank/network-jobs"
  fi
  echo

  if [[ "$yes" -ne 1 ]]; then
    if [[ ! -t 0 ]]; then
      echo "error: non-interactive shell — pass --yes to confirm" >&2
      return 1
    fi
    printf "Continue? [y/N] "
    local answer
    read -r answer
    case "$answer" in
      y|Y|yes|YES) ;;
      *) echo "Aborted."; return 1 ;;
    esac
  fi

  local removed=0 skipped=0
  for name in "${agent_names[@]}"; do
    dir="$(network_jobs_agent_dir "$name" || true)"
    if [[ -z "$dir" ]]; then
      echo "warning: unknown agent '$name' — skipped" >&2
      continue
    fi
    for skill in "${NETWORK_JOBS_SKILL_IDS[@]}"; do
      dest="$dir/$skill"
      if [[ -L "$dest" || -e "$dest" ]]; then
        rm -rf "$dest"
        echo "removed $dest"
        removed=$((removed + 1))
      else
        skipped=$((skipped + 1))
      fi
    done
  done

  if [[ "$wipe_data" -eq 1 ]]; then
    if [[ -e "$DATA_HOME" || -L "$DATA_HOME" ]]; then
      rm -rf "$DATA_HOME"
      echo "removed $DATA_HOME"
    else
      echo "no data dir at $DATA_HOME"
    fi
  fi

  if [[ "$purge_cache" -eq 1 ]]; then
    local cache
    for cache in \
      "$HOME/.local/share/pnpm/store/v11/links/@hirefrank/network-jobs"
    do
      if [[ -e "$cache" || -L "$cache" ]]; then
        rm -rf "$cache"
        echo "removed $cache"
      fi
    done
    if [[ -d "$HOME/.cache/pnpm/dlx" ]]; then
      find "$HOME/.cache/pnpm/dlx" -maxdepth 2 -iname '*network-jobs*' -exec rm -rf {} + 2>/dev/null || true
      echo "cleared matching pnpm dlx entries (best-effort)"
    fi
  fi

  echo
  echo "Reset complete ($removed removed)."
  if [[ "$wipe_data" -eq 1 ]]; then
    echo "Reinstall: npx github:hirefrank/network-jobs setup --agent auto"
  else
    echo "Re-link skills: network-jobs setup --agent auto"
  fi
}

cmd_doctor() {
  if network_jobs_want_help "$@"; then
    usage_doctor
    return 0
  fi
  if [[ $# -gt 0 ]]; then
    echo "Unknown arg: $1" >&2
    echo "Try: network-jobs doctor --help" >&2
    return 1
  fi

  local ok=1
  echo "==> Network Jobs doctor"
  echo "    Suite: $ROOT"
  echo "    Data:  $DATA_HOME"
  echo

  for tool in curl jq unzip python3; do
    if command -v "$tool" >/dev/null 2>&1; then
      echo "OK  $tool"
    else
      echo "MISS $tool"
      ok=0
    fi
  done
  if command -v agent-browser >/dev/null 2>&1; then
    echo "OK  agent-browser"
  else
    echo "WARN agent-browser missing (optional) — network-jobs setup --with-browser"
  fi
  echo

  for p in connections companies config triage corpus logs; do
    if [[ -d "$DATA_HOME/$p" ]]; then
      echo "OK  $DATA_HOME/$p"
    else
      echo "MISS $DATA_HOME/$p — run: network-jobs setup"
      ok=0
    fi
  done

  if [[ -f "$DATA_HOME/profile.json" ]]; then
    local name email
    name="$(jq -r '.name // empty' "$DATA_HOME/profile.json" 2>/dev/null || true)"
    email="$(jq -r '.email // empty' "$DATA_HOME/profile.json" 2>/dev/null || true)"
    if [[ -n "$name" && -n "$email" ]]; then
      echo "OK  profile ($name / $email)"
    else
      echo "WARN profile.json incomplete (name/email) — use network-jobs-setup skill"
    fi
  else
    echo "MISS profile.json"
    ok=0
  fi

  if [[ -f "$DATA_HOME/companies/companies.json" ]]; then
    echo "OK  companies ($(jq 'length' "$DATA_HOME/companies/companies.json") entries)"
  else
    echo "WARN no companies.json — run network-jobs import"
  fi

  if [[ -f "$DATA_HOME/corpus/manifest.json" ]]; then
    echo "OK  corpus totalJobs=$(jq -r '.totalJobs // 0' "$DATA_HOME/corpus/manifest.json")"
  fi

  echo
  echo "==> Skill links"
  local a_name a_dir a_hint skill linked
  while IFS= read -r line; do
    IFS=$'\t' read -r a_name a_dir a_hint <<<"$line"
    [[ -z "$a_hint" ]] && continue
    linked=0
    for skill in "${NETWORK_JOBS_SKILL_IDS[@]}"; do
      if [[ -e "$a_dir/$skill/SKILL.md" ]]; then
        linked=$((linked + 1))
      fi
    done
    echo "$a_name: $linked/${#NETWORK_JOBS_SKILL_IDS[@]} skills in $a_dir"
  done < <(network_jobs_list_agents)

  echo
  if [[ "$ok" -eq 1 ]]; then
    echo "Doctor: OK"
    return 0
  fi
  echo "Doctor: issues found"
  return 1
}

cmd_import() {
  if network_jobs_want_help "$@"; then
    usage_import
    return 0
  fi

  local input="${1:-}"
  if [[ -z "$input" ]]; then
    usage_import >&2
    return 1
  fi
  shift || true
  local helper="$ROOT/skills/network-jobs-import/helpers/parse-linkedin.sh"
  if [[ ! -x "$helper" ]]; then
    echo "ERROR: missing $helper" >&2
    return 1
  fi
  mkdir -p "$DATA_HOME"
  "$helper" "$input" --out "$DATA_HOME" "$@"
}

cmd_agents() {
  if network_jobs_want_help "$@"; then
    usage_agents
    return 0
  fi
  if [[ $# -gt 0 ]]; then
    echo "Unknown arg: $1" >&2
    echo "Try: network-jobs agents --help" >&2
    return 1
  fi
  network_jobs_list_agents
}

cmd_routing() {
  if network_jobs_want_help "$@"; then
    usage_routing
    return 0
  fi
  if [[ $# -gt 0 ]]; then
    echo "Unknown arg: $1" >&2
    echo "Try: network-jobs routing --help" >&2
    return 1
  fi
  local snippet="$ROOT/docs/AGENTS.md.snippet"
  if [[ -f "$snippet" ]]; then
    cat "$snippet"
  else
    echo "ERROR: missing $snippet" >&2
    return 1
  fi
}

cmd_which() {
  if network_jobs_want_help "$@"; then
    usage_which
    return 0
  fi
  if [[ $# -gt 0 ]]; then
    echo "Unknown arg: $1" >&2
    echo "Try: network-jobs which --help" >&2
    return 1
  fi
  echo "suite=$ROOT"
  echo "data=$DATA_HOME"
}

case "$cmd" in
  ""|-h|--help) usage ;;
  -V|--version|version) network_jobs_version ;;
  help) cmd_help "$@" ;;
  setup)
    if network_jobs_want_help "$@"; then
      usage_setup
    else
      exec "$ROOT/setup" "$@"
    fi
    ;;
  doctor) cmd_doctor "$@" ;;
  import) cmd_import "$@" ;;
  reset) cmd_reset "$@" ;;
  uninstall) cmd_reset --data "$@" ;;
  agents) cmd_agents "$@" ;;
  routing) cmd_routing "$@" ;;
  which) cmd_which "$@" ;;
  *)
    echo "Unknown command: $cmd" >&2
    echo "Try: network-jobs --help" >&2
    exit 1
    ;;
esac
