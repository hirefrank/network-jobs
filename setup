#!/usr/bin/env bash
# Network Jobs suite installer.
# Creates ~/.network-jobs and symlinks skills into one or more agent skill dirs.
set -euo pipefail

SUITE_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib/agents.sh
source "$SUITE_ROOT/lib/agents.sh"

DATA_HOME="${NETWORK_JOBS_HOME:-$HOME/.network-jobs}"
SKILLS_SRC="$SUITE_ROOT/skills"

SKILLS=(
  network-jobs-setup
  network-jobs-import
  careers-discover
  jobs-ingest
  network-jobs
  intro-email-generator
)

AGENTS_CSV=""
COPY_MODE=0
YES=0

usage() {
  cat <<'EOF'
Usage: setup [--agent name[,name...]|all|auto] [--copy] [--yes]

  --agent   Target agents (default: auto = detect installed agents)
            Examples: claude-code,cursor,codex  |  all  |  auto
  --copy    Copy skills instead of symlinking
  --yes     Non-interactive

Also accepts NETWORK_JOBS_SKILLS_DIR as a single explicit skills parent
(overrides --agent for that one path).
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help) usage; exit 0 ;;
    --agent|--agents) AGENTS_CSV="$2"; shift 2 ;;
    --copy) COPY_MODE=1; shift ;;
    --yes|-y) YES=1; shift ;;
    *) echo "Unknown arg: $1" >&2; usage; exit 1 ;;
  esac
done

echo "==> Network Jobs setup"
echo "    Suite: $SUITE_ROOT"
echo "    Data:  $DATA_HOME"
echo

# --- dependency checks ---
missing=()
for cmd in curl jq unzip python3; do
  if ! command -v "$cmd" >/dev/null 2>&1; then
    missing+=("$cmd")
  fi
done
if ((${#missing[@]})); then
  echo "ERROR: missing required tools: ${missing[*]}"
  exit 1
fi

if command -v agent-browser >/dev/null 2>&1; then
  echo "OK  agent-browser found"
else
  echo "WARN agent-browser not found (optional; use curl/WebFetch for many career pages)"
fi
echo

# --- data dirs ---
mkdir -p \
  "$DATA_HOME/connections" \
  "$DATA_HOME/companies" \
  "$DATA_HOME/config" \
  "$DATA_HOME/triage" \
  "$DATA_HOME/corpus" \
  "$DATA_HOME/logs"

ASSET_DIR="$SKILLS_SRC/network-jobs-import/assets"
for f in companies-to-ignore.json company-words-to-ignore.json company-overrides.json; do
  if [[ ! -f "$DATA_HOME/config/$f" && -f "$ASSET_DIR/$f" ]]; then
    cp "$ASSET_DIR/$f" "$DATA_HOME/config/$f"
    echo "Seeded config/$f"
  fi
done

if [[ ! -f "$DATA_HOME/profile.json" ]]; then
  cat > "$DATA_HOME/profile.json" <<'EOF'
{
  "name": "",
  "email": "",
  "title": "",
  "company": "",
  "url": ""
}
EOF
  echo "Created profile.json (fill via network-jobs-setup skill)"
fi

if [[ ! -f "$DATA_HOME/corpus/manifest.json" ]]; then
  cat > "$DATA_HOME/corpus/manifest.json" <<'EOF'
{
  "lastUpdated": null,
  "totalJobs": 0,
  "categories": {}
}
EOF
fi

# Persist suite root for helpers/skills
echo "$SUITE_ROOT" > "$DATA_HOME/suite-root"
export NETWORK_JOBS_SUITE="$SUITE_ROOT"

# --- resolve target skill parents ---
declare -a TARGET_DIRS=()
declare -a TARGET_LABELS=()

if [[ -n "${NETWORK_JOBS_SKILLS_DIR:-}" ]]; then
  TARGET_DIRS+=("$NETWORK_JOBS_SKILLS_DIR")
  TARGET_LABELS+=("custom")
else
  AGENTS_CSV="${AGENTS_CSV:-auto}"
  declare -a agent_names=()
  case "$AGENTS_CSV" in
    all)
      agent_names=("${NETWORK_JOBS_AGENT_IDS[@]}")
      ;;
    auto)
      while IFS= read -r name; do
        [[ -n "$name" ]] && agent_names+=("$name")
      done < <(network_jobs_detect_agents)
      ;;
    *)
      IFS=',' read -ra agent_names <<<"$AGENTS_CSV"
      ;;
  esac

  for name in "${agent_names[@]}"; do
    name="$(echo "$name" | xargs)"
    [[ -z "$name" ]] && continue
    dir="$(network_jobs_agent_dir "$name" || true)"
    if [[ -z "$dir" ]]; then
      echo "WARN unknown agent '$name' — skip"
      continue
    fi
    TARGET_DIRS+=("$dir")
    TARGET_LABELS+=("$name")
  done
fi

if ((${#TARGET_DIRS[@]} == 0)); then
  echo "ERROR: no agent skill directories selected"
  exit 1
fi

install_skill() {
  local src="$1" dest="$2"
  mkdir -p "$(dirname "$dest")"
  if [[ -L "$dest" ]]; then
    rm -f "$dest"
  elif [[ -e "$dest" ]]; then
    if [[ "$(cd "$dest" 2>/dev/null && pwd)" == "$(cd "$src" && pwd)" ]]; then
      echo "OK  already present: $dest"
      return 0
    fi
    echo "WARN $dest exists and is not a symlink — skip (remove to relink)"
    return 0
  fi
  if [[ "$COPY_MODE" -eq 1 ]]; then
    rm -rf "$dest"
    cp -R "$src" "$dest"
    echo "Copied $dest"
  else
    ln -sfn "$src" "$dest"
    echo "Linked $dest -> $src"
  fi
}

echo "==> Installing skills"
for i in "${!TARGET_DIRS[@]}"; do
  parent="${TARGET_DIRS[$i]}"
  label="${TARGET_LABELS[$i]}"
  echo "---- $label ($parent)"
  mkdir -p "$parent"
  # Refuse installing suite root into a path that would collide with skill name
  if [[ "$(basename "$parent")" == "network-jobs" ]]; then
    echo "ERROR: refusing skills parent named network-jobs: $parent"
    exit 1
  fi
  for skill in "${SKILLS[@]}"; do
    src="$SKILLS_SRC/$skill"
    if [[ ! -d "$src" ]]; then
      echo "WARN missing $src"
      continue
    fi
    install_skill "$src" "$parent/$skill"
  done
done

SNIPPET="$SUITE_ROOT/docs/AGENTS.md.snippet"
if [[ -f "$SNIPPET" ]]; then
  echo
  echo "==> Paste into CLAUDE.md / AGENTS.md / agent instructions:"
  echo "----"
  cat "$SNIPPET"
  echo "----"
fi

{
  echo "$(date -u +%Y-%m-%dT%H:%M:%SZ) setup ok suite=$SUITE_ROOT data=$DATA_HOME agents=${TARGET_LABELS[*]}"
} >> "$DATA_HOME/logs/setup.log"

echo
echo "Done. Next:"
echo "  1. Fill profile via the network-jobs-setup skill (in your agent)"
echo "  2. network-jobs import ~/Downloads/Connections.zip"
echo "  Or: ask your agent to import your LinkedIn ZIP"
